{
  "apiVersion": 1,
  "title": "天国",
  "artist": "四时小路Komichi",
  "lines": [
    {
      "start": 0.479,
      "end": 4.818,
      "text": "あ、朝、目が覚めたら"
    },
    {
      "start": 4.818,
      "end": 10.887,
      "text": "私じゃない　嘘みたいだ"
    },
    {
      "start": 10.887,
      "end": 15.75,
      "text": "あ、何処からか溢れ出している"
    },
    {
      "start": 15.75,
      "end": 22.079,
      "text": "蜜の香りが私を誘い込んでいる"
    },
    {
      "start": 32.119,
      "end": 34.579,
      "text": "裸足で何処まで往けるかな"
    },
    {
      "start": 34.579,
      "end": 37.098,
      "text": "海の向こう　天国へ"
    },
    {
      "start": 37.098,
      "end": 39.87,
      "text": "ほらもっと遠くに拐って"
    },
    {
      "start": 39.87,
      "end": 42.942,
      "text": "底無しの愛に沈めて殺して"
    },
    {
      "start": 42.942,
      "end": 45.119,
      "text": "無いものばっか望むから"
    },
    {
      "start": 45.119,
      "end": 47.792,
      "text": "ほら私の手を引いて"
    },
    {
      "start": 47.792,
      "end": 51.889,
      "text": "優しい声でこの罪ごと認めて"
    },
    {
      "start": 51.889,
      "end": 54.493,
      "text": "私だけの天国へ"
    },
    {
      "start": 62.483,
      "end": 67.5,
      "text": "貴方だけの天国へ"
    }
  ]
}
