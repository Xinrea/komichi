{
  "apiVersion": 1,
  "title": "大女優さん",
  "artist": "四时小路Komichi",
  "lines": [
    {
      "start": 10.3,
      "text": "ショートフィルムを録ろう。",
      "end": 11.75
    },
    {
      "start": 11.75,
      "text": "約五十秒",
      "end": 12.79
    },
    {
      "start": 12.79,
      "text": "眠気がピークになれる邦画",
      "end": 14.39
    },
    {
      "start": 14.39,
      "text": "暇で曖昧、嫌いな機械",
      "end": 16.19
    },
    {
      "start": 16.19,
      "text": "もっと始終踊ろう。",
      "end": 17.61
    },
    {
      "start": 17.61,
      "text": "ラスト数秒ですべてが",
      "end": 18.96
    },
    {
      "start": 18.96,
      "text": "ひっくり返るような、",
      "end": 20.05
    },
    {
      "start": 20.05,
      "text": "いかれた一人芝居がしたい。",
      "end": 21.85
    },
    {
      "start": 21.85,
      "text": "今日も卑屈の孤島",
      "end": 23.05
    },
    {
      "start": 23.05,
      "text": "約束・烏合に向けてはヒールになれ",
      "end": 25.24
    },
    {
      "start": 25.24,
      "text": "口説くな。",
      "end": 25.88
    },
    {
      "start": 25.88,
      "text": "見たネタにもシビアになりたい。",
      "end": 27.37
    },
    {
      "start": 27.37,
      "text": "法と理屈を問おう。",
      "end": 28.53
    },
    {
      "start": 28.53,
      "text": "まず女優をゆめ",
      "end": 29.67
    },
    {
      "start": 29.67,
      "text": "腕がいい筋まで募るな。",
      "end": 31.33
    },
    {
      "start": 31.33,
      "text": "慕えない距離には違いない。",
      "end": 34.25
    },
    {
      "start": 34.25,
      "text": "「ということで、",
      "end": 34.87
    },
    {
      "start": 34.87,
      "text": "後輩二人に声をかけて",
      "end": 36.47
    },
    {
      "start": 36.47,
      "text": "演じてもらうことにしました。」",
      "end": 38.05
    },
    {
      "start": 38.05,
      "text": "演じてもらうことにした。",
      "end": 39.61
    },
    {
      "start": 39.61,
      "text": "シナリオは、毒にも薬にもならない",
      "end": 41.91
    },
    {
      "start": 41.91,
      "text": "でも二人だったら",
      "end": 42.91
    },
    {
      "start": 42.91,
      "text": "到底するわけのない",
      "end": 44.03
    },
    {
      "start": 44.03,
      "text": "殴り合いの大喧嘩。 大女優も　愛の渦も",
      "end": 50.65
    },
    {
      "start": 50.65,
      "text": "完璧なプロットで動く ああ",
      "end": 56.23
    },
    {
      "start": 56.23,
      "text": "最小限のビラ広告と",
      "end": 61.88
    },
    {
      "start": 61.88,
      "text": "私がいなくなってる 手紙箱の中",
      "end": 69.0
    },
    {
      "start": 73.01,
      "text": "建設的な議論ができなくなる程の",
      "end": 74.95
    },
    {
      "start": 74.95,
      "text": "喧嘩が起こって",
      "end": 75.84
    },
    {
      "start": 75.84,
      "text": "ショートフィルムはお釈迦。",
      "end": 77.18
    },
    {
      "start": 77.18,
      "text": "「前はそんなつまらない人じゃ",
      "end": 78.67
    },
    {
      "start": 78.67,
      "text": "なかったですよね。」",
      "end": 79.91
    },
    {
      "start": 79.91,
      "text": "告げる後輩を見て、",
      "end": 80.92
    },
    {
      "start": 80.92,
      "text": "ひどく心がえぐられて",
      "end": 82.59
    },
    {
      "start": 82.59,
      "text": "それ以上続けられなかった。",
      "end": 84.01
    },
    {
      "start": 84.01,
      "text": "「・・・」",
      "end": 85.97
    },
    {
      "start": 85.97,
      "text": "仕方がないので代わりのシーンを",
      "end": 87.73
    },
    {
      "start": 87.73,
      "text": "自分で演じて埋めてみた。",
      "end": 89.62
    },
    {
      "start": 89.62,
      "text": "「ああ、あいつらにサインでも",
      "end": 92.27
    },
    {
      "start": 92.27,
      "text": "貰っておけばよかった。」",
      "end": 93.93
    },
    {
      "start": 93.93,
      "text": "そう思って提出した",
      "end": 95.35
    },
    {
      "start": 95.35,
      "text": "ショートフィルムが入賞した。",
      "end": 97.18
    },
    {
      "start": 97.18,
      "text": "愛きょう・ユーモア",
      "end": 100.02
    },
    {
      "start": 100.02,
      "text": "目・鼻も",
      "end": 102.8
    },
    {
      "start": 102.8,
      "text": "完璧なプロットで動く ああ",
      "end": 108.31
    },
    {
      "start": 108.31,
      "text": "大長編と見まごう速度",
      "end": 113.84
    },
    {
      "start": 113.84,
      "text": "私が今座ってる",
      "end": 117.83
    },
    {
      "start": 117.83,
      "text": "女神はその中",
      "end": 119.3
    },
    {
      "start": 119.3,
      "text": "欲しかったものは大体全部",
      "end": 121.04
    },
    {
      "start": 121.04,
      "text": "手に入ってしまった。",
      "end": 122.25
    },
    {
      "start": 122.25,
      "text": "持て余した時間で",
      "end": 123.2
    },
    {
      "start": 123.2,
      "text": "古びたデータを見つけ出した。",
      "end": 125.0
    },
    {
      "start": 127.71,
      "text": "開始数秒で、日記帳を目の前で",
      "end": 129.77
    },
    {
      "start": 129.77,
      "text": "朗読されているような",
      "end": 130.63
    },
    {
      "start": 130.63,
      "text": "気分になった。",
      "end": 132.31
    },
    {
      "start": 132.31,
      "text": "あまりにも都合の良い筋書き、",
      "end": 134.37
    },
    {
      "start": 134.37,
      "text": "あふれ出る妄想、",
      "end": 135.65
    },
    {
      "start": 135.65,
      "text": "理想的に創られた自分。",
      "end": 137.78
    },
    {
      "start": 137.78,
      "text": "言葉遊びの端まで吊り下げられた",
      "end": 140.13
    },
    {
      "start": 140.13,
      "text": "自尊心の塊。",
      "end": 141.74
    },
    {
      "start": 141.74,
      "text": "「よくもこんな面白いものを",
      "end": 143.45
    },
    {
      "start": 143.45,
      "text": "作ってくれたな。」",
      "end": 145.08
    },
    {
      "start": 145.08,
      "text": "思わず笑い声を",
      "end": 146.13
    },
    {
      "start": 146.13,
      "text": "出してしまった瞬間に、",
      "end": 148.3
    },
    {
      "start": 148.3,
      "text": "それが画面の向こう側から",
      "end": 150.0
    },
    {
      "start": 150.0,
      "text": "聞こえていることに気が付いた。",
      "end": 151.87
    },
    {
      "start": 151.87,
      "text": "ショートフィルムを録ろう。",
      "end": 153.25
    },
    {
      "start": 153.25,
      "text": "約五十秒",
      "end": 154.14
    },
    {
      "start": 154.14,
      "text": "眠気がピークになれる邦画",
      "end": 156.0
    },
    {
      "start": 156.0,
      "text": "暇で曖昧、嫌いな機械",
      "end": 157.94
    },
    {
      "start": 157.94,
      "text": "もっと始終踊ろう。",
      "end": 159.45
    },
    {
      "start": 159.45,
      "text": "ラスト数秒ですべてが",
      "end": 161.1
    },
    {
      "start": 161.1,
      "text": "ひっくり返るような、",
      "end": 162.03
    },
    {
      "start": 162.03,
      "text": "いかれた一人芝居がしたい。",
      "end": 164.37
    },
    {
      "start": 164.37,
      "text": "大女優もどきと言われたくないの",
      "end": 167.71
    },
    {
      "start": 167.71,
      "text": "うずもれたまま、いつ",
      "end": 169.9
    },
    {
      "start": 169.9,
      "text": "完璧なプロットで動くのですか",
      "end": 174.76
    },
    {
      "start": 174.76,
      "text": "認められぬ再証言 覗き込んだ扉",
      "end": 178.77
    },
    {
      "start": 178.77,
      "text": "鴻鵠飛び立つ窓辺に",
      "end": 181.25
    },
    {
      "start": 181.25,
      "text": "私がいなくなってる 手紙箱の中",
      "end": 189.5
    }
  ]
}
