{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folia-light.local/schemas/lyrics-v1.schema.json",
  "title": "Folia Light Lyrics v1",
  "type": "object",
  "required": ["apiVersion", "lines"],
  "properties": {
    "apiVersion": { "const": 1 },
    "title": { "type": "string" },
    "artist": { "type": "string" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "text"],
        "properties": {
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "text": { "type": "string", "minLength": 1 },
          "translation": { "type": "string" },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "start", "end"],
              "properties": {
                "text": { "type": "string" },
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

